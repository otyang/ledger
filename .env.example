# Copy to .env and adjust. `make run` reads .env; .env is git-ignored.

# Postgres connection (required). The ledger creates and uses the "ledger"
# schema inside this database.
LEDGER_DATABASE_URL=postgres://postgres@localhost:5432/ledger?sslmode=disable

# Bearer token clients must send as "Authorization: Bearer <token>" (required).
LEDGER_API_TOKEN=change-me

# Listen address. Default :7710.
# LEDGER_ADDR=:7710

# Per-request timeout, including time spent waiting for account locks. Default 10s.
# LEDGER_REQUEST_TIMEOUT=10s

# Only when something in front of the service already authenticates requests.
# LEDGER_INSECURE_NO_AUTH=true

# Requests per second allowed per client IP, and the burst size. Default: no limit.
# LEDGER_RATE_LIMIT=50
# LEDGER_RATE_BURST=100

# How often expired holds are released, and untracked-account balance
# snapshots refreshed. 0 disables either. Defaults 1m and 5m.
# LEDGER_HOLD_EXPIRY_INTERVAL=1m
# LEDGER_SNAPSHOT_INTERVAL=5m

# Deliver every event to this URL, signed with the secret. Default: off.
# LEDGER_WEBHOOK_URL=https://example.com/ledger-events
# LEDGER_WEBHOOK_SECRET=change-me-too

# On shutdown, keep serving this long with /readyz failing, so a load
# balancer stops routing first. Default 0.
# LEDGER_SHUTDOWN_DRAIN=10s
